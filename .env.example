# LocalGravity — Environment Variables Template
# Copy this file to .env and fill in any local overrides.
# NEVER commit .env — it is in .gitignore.

# Ollama API host (must stay on localhost)
OLLAMA_HOST=http://127.0.0.1:11434

# Absolute path to the default workspace (leave empty to prompt on first launch)
WORKSPACE_ROOT=

# Maximum file size the backend will read into memory
MAX_FILE_SIZE_MB=10

# Seconds before a terminal command is force-killed
TERMINAL_TIMEOUT_SECONDS=30
